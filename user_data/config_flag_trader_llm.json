{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 1,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 1,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "timeframe": "1d",
    "cancel_open_orders_on_exit": true,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "freqai": {
        "enabled": true,
        "purge_old_models": 2,
        "train_period_days": 1000,
        "backtest_period_days": 60,
        "live_retrain_hours": 0,
        "identifier": "flag-trader-llm",
        "feature_parameters": {
            "include_timeframes": [
                "1d"
            ],
            "include_corr_pairlist": [],
            "label_period_candles": 20,
            "include_shifted_candles": 2,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": false,
            "indicator_periods_candles": [
                10,
                20
            ],
            "plot_feature_importances": 0
        },
        "data_split_parameters": {
            "test_size": 0.2,
            "random_state": 1
        },
        "rl_config": {
            "train_cycles": 50,
            "add_state_info": false,
            "max_trade_duration_candles": 300,
            "max_training_drawdown_pct": 0.02,
            
            "llm_model_path": "user_data/models/llm/SmolLM2-135M-Instruct",
            "freeze_layers": 25,
            "max_prompt_length": 512,
            
            "learning_rate": 0.0005,
            "gamma": 0.95,
            "gae_lambda": 0.98,
            "clip_coef": 0.2,
            "ent_coef": 0.05,
            "vf_coef": 0.5,
            "max_grad_norm": 0.5,
            
            "ppo_epochs": 1,
            "mini_batch_size": 32,
            "train_batch_size": 40,
            "gradient_accumulation_steps": 8,
            "prediction_batch_size": 32,
            
            "model_reward_parameters": {
                "rr": 1,
                "profit_aim": 0.025
            },
            "model_training_parameters": {
                "device": "cuda"
            }
        },
        "model_training_parameters": {}
    },
    "bot_name": "FlagTrader-LLM",
    "force_entry_enable": true,
    "initial_state": "running",
    "internals": {
        "process_throttle_secs": 5
    }
}

