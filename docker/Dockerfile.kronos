# Kronos 专用 Dockerfile - 基于 NVIDIA NGC PyTorch 镜像
FROM nvcr.io/nvidia/pytorch:25.09-py3

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /freqtrade

# 1. 安装系统依赖
RUN apt-get update && apt-get install -y \
    libatlas3-base sqlite3 git curl libhdf5-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. 复制整个项目
COPY . .

# 3. 移除 torch/nvidia 版本限制 (使用 NGC 镜像自带的 CUDA 版本)
RUN sed -i '/^torch/d' requirements*.txt 2>/dev/null || true
RUN sed -i '/^nvidia/d' requirements*.txt 2>/dev/null || true

# 4. 安装 Freqtrade 核心依赖
RUN pip install --no-cache-dir -r requirements.txt

# 5. 安装 FreqAI 依赖 (忽略错误继续)
RUN pip install --no-cache-dir -r requirements-freqai.txt || true

# 6. 安装 Kronos 需要的额外包
RUN pip install --no-cache-dir transformers accelerate einops

# 7. 安装 Freqtrade
RUN pip install -e . --no-deps || pip install -e .

# 8. 设置入口
ENTRYPOINT ["freqtrade"]
CMD ["trade"]
